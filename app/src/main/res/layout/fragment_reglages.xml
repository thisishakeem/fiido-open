<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="Réglages"
            android:textColor="@color/txt"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Conformité -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:text="CONFORMITÉ FRANÇAISE"
            android:textColor="@color/txtDim"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gâchette (accélérateur)" android:textColor="@color/txt" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Désactivée — aide au démarrage ≤ 6 km/h" android:textColor="@color/txtDim" android:textSize="12.5sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swThrottle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginHorizontal="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mode poussette" android:textColor="@color/txt" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Assistance à la marche, 6 km/h max" android:textColor="@color/txtDim" android:textSize="12.5sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swWalk" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginHorizontal="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Assistance limitée" android:textColor="@color/txt" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Coupure du moteur à 25 km/h" android:textColor="@color/txtDim" android:textSize="12.5sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="25 km/h" android:textColor="@color/primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingTop="12dp"
            android:text="Objectif : restaurer la conformité au code de la route français. Aucune modification du firmware du contrôleur, aucun débridage au-delà de 25 km/h."
            android:textColor="@color/txtDim"
            android:textSize="11.5sp" />

        <!-- Dev tools header -->
        <TextView
            android:id="@+id/devHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingVertical="10dp"
            android:text="▸ Outils développeur"
            android:textColor="@color/txtDim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/devBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:id="@+id/btnReconnect" style="@style/DevBtn" android:text="Reconnecter le vélo" />
            <TextView android:id="@+id/btnScanReg" style="@style/DevBtn" android:text="Scanner les registres (0x00–0x40)" />
            <TextView android:id="@+id/btnT2708" style="@style/DevBtn" android:text="Test 0x27 = 0x08" />
            <TextView android:id="@+id/btnT2780" style="@style/DevBtn" android:text="Test 0x27 = 0x80" />
            <TextView android:id="@+id/btnT2700" style="@style/DevBtn" android:text="Test 0x27 = 0x00" />
            <TextView android:id="@+id/btnT2B40" style="@style/DevBtn" android:text="Test 0x2B = 0x40" />
            <TextView android:id="@+id/btnT2B00" style="@style/DevBtn" android:text="Test 0x2B = 0x00" />
            <TextView android:id="@+id/btnShareLog" style="@style/DevBtn" android:text="Partager le journal" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FF0E1A1C"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:text=""
                android:textColor="#FF9FE8D6"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Fiido Open"
            android:textColor="@color/txtDim"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
