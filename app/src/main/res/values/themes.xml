<resources>
    <style name="Theme.FiidoOpen" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:fontFamily">@font/fiido_sans</item>
        <item name="fontFamily">@font/fiido_sans</item>
        <item name="materialCardViewStyle">@style/CardFiido</item>
    </style>

    <style name="CardFiido" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
